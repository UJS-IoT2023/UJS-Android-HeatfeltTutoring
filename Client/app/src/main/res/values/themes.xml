<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.HeartfeltTutoringClient" parent="Theme.Material3.DayNight.NoActionBar">

        <item name="colorPrimary">@color/purple_muted_primary</item>
        <item name="colorOnPrimary">@color/purple_muted_on_primary</item>

        <item name="colorPrimaryContainer">@color/purple_muted_container</item>
        <item name="colorOnPrimaryContainer">@color/purple_muted_on_container</item>

        <item name="colorSecondary">@color/secondary_muted</item>
        <item name="colorOnSecondary">@color/secondary_on_muted</item>
        <item name="colorSecondaryContainer">@color/secondary_muted_container</item>
        <item name="colorOnSecondaryContainer">@color/secondary_on_muted_container</item>

        <item name="colorTertiary">@color/purple_muted_primary</item>
        <item name="colorOnTertiary">@color/purple_muted_on_primary</item>

        <item name="colorSurface">@color/surface_warm</item>
        <item name="colorOnSurface">@color/on_surface_warm</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <item name="colorOutline">@color/on_surface_variant</item>

        <item name="android:statusBarColor">@color/surface_warm</item>
        <item name="android:windowLightStatusBar">true</item> <item name="materialButtonStyle">@style/Widget.Material3.Button</item>
    </style>

    <style name="Theme.HeartfeltTutoringClient.NoActionBar" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.HeartfeltTutoringClient.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />
    <style name="Theme.HeartfeltTutoringClient.PopupOverlay" parent="ThemeOverlay.Material3.Light" />
